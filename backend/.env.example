DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism

# Artifact storage backend: "local" (default) or "s3"
STORAGE_BACKEND=local

# Local storage root (used when STORAGE_BACKEND=local)
LOCAL_ARTIFACT_ROOT=/tmp/prism-artifacts

# S3 settings (required when STORAGE_BACKEND=s3)
# S3_BUCKET_NAME=prism-artifact-storage-prismartifactbucket-ubri8x7giofh
# AWS_REGION=ap-south-1
#
# AWS credentials are NOT stored here. The SDK's default credential chain is
# used: ~/.aws/credentials (local dev) or an EC2/ECS IAM role (production).
# The runtime environment will need an IAM role with at least:
#   s3:PutObject, s3:GetObject, s3:DeleteObject  scoped to the bucket ARN.
# Do NOT add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY to source control.

# Review provider: "gemini" (default) or "openai"
REVIEW_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
REVIEW_REQUEST_TIMEOUT_SECONDS=90

# Optional OpenAI provider settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# GitHub Actions OIDC coverage intake.
# The audience must match `audience: prism` in the workflow's OIDC token request.
# Keep the allowlist restricted to a single repo + workflow path; use a branch
# wildcard only if you accept uploads from multiple branches of that repo.
# No GitHub App actions:read permission is needed for this upload path.
#
# Example for the installed Codedocket repository's CI workflow:
GITHUB_ACTIONS_OIDC_AUDIENCE=prism
GITHUB_COVERAGE_TRUSTED_WORKFLOW_REFS=["Amaan-Khan14/codedocket/.github/workflows/ci.yml@refs/heads/*"]

# GitHub App credentials for reading pull requests (keep the PEM outside Git)
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem
# GITHUB_APP_SLUG=pr-review-prism
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
# GITHUB_APP_SETUP_URL=http://localhost:8000/auth/github/install/callback

# Authentication secrets: generate independent random values; never commit them.
# AUTH_SESSION_SECRET must be at least 32 characters.
# GITHUB_TOKEN_ENCRYPTION_KEY must be base64-encoded 32 random bytes.
# Example generation: python -c 'import secrets,base64; print(secrets.token_urlsafe(48)); print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# AUTH_SESSION_SECRET=
# GITHUB_TOKEN_ENCRYPTION_KEY=
# AUTH_COOKIE_SECURE=false  # local HTTP only; set true behind HTTPS
# AUTH_COOKIE_SAMESITE=lax  # use none only for cross-site frontend/API hosting, with HTTPS
# AUTH_FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
